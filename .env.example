# Copy this file to .env.local and fill in your Supabase credentials.
# Get these from https://supabase.com/dashboard -> Your Project -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables a demo mode that uses local mock data when Supabase is not configured.
# Set to "true" to skip Supabase entirely (useful for quick previews / submission demos).
NEXT_PUBLIC_DEMO_MODE=true
